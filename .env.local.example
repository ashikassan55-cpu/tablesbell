# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (.gitignore: .env*.local) -- never commit real secrets.

# --- Firebase client SDK config (lib/firebase/client.ts) -------------
# Public by design (NEXT_PUBLIC_*) -- these identify the project, they
# are not secrets. Firestore access is still fully gated by
# firestore.rules regardless of who can see these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (ARCHITECTURE.md §8.5) -- reCAPTCHA v3 site key. Leave unset
# to leave App Check un-initialized in development; client.ts warns
# rather than crashing.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Public origin the printed guest QR codes point at, e.g.
# https://app.tablebells.ae or http://localhost:3000 for a local preview.
# The Manager Table Management QR exporter builds `${NEXT_PUBLIC_APP_URL}/t/{slug}`.
# No trailing slash. Falls back to https://app.tablebells.ae when unset.
NEXT_PUBLIC_APP_URL=

# --- Device cookie signing (server/auth/device-cookie.ts) -------------
# Generate with: openssl rand -base64 32
DEVICE_COOKIE_SECRET=

# --- Staff session cookie signing (server/auth/staff-session-cookie.ts) -
# Generate with: openssl rand -base64 32
# DELIBERATELY a separate secret from DEVICE_COOKIE_SECRET.
STAFF_SESSION_SECRET=

# --- Firebase Admin SDK (lib/firebase/admin.ts) -----------------------
# Unified local + Vercel credentials, supplied through env vars only --
# no service-account JSON key file in the repo. Source: Firebase console
# -> Project settings -> Service accounts -> "Generate new private key"
# (downloads a JSON with project_id, client_email, private_key).
#
# FIREBASE_PRIVATE_KEY: paste on ONE line, double-quoted, keeping the
# literal \n escapes from the downloaded JSON. admin.ts converts them
# back to real newlines at runtime. Example:
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
#
# On Vercel: add these same three as Environment Variables (paste the key
# with its \n intact).
#
# Leave CLIENT_EMAIL + PRIVATE_KEY unset to fall back to Application
# Default Credentials (Workload Identity on Cloud Run / Functions, or a
# local `gcloud auth application-default login`).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
