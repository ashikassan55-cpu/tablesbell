# Copy this file to .env.local and fill in real values.
# .env.local is gitignored -- never commit real secrets to either file.

# --- Firebase client SDK config (lib/firebase/client.ts) -------------
# Public by design (NEXT_PUBLIC_*) -- these identify the project, they
# are not secrets. Firestore access is still fully gated by
# firestore.rules regardless of who can see these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (ARCHITECTURE.md §8.5) -- reCAPTCHA v3 site key. Leave unset
# to leave App Check un-initialized in development; client.ts warns
# rather than crashing.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Public origin the printed guest QR codes point at, e.g.
# https://app.tablebells.ae -- the Manager Table Management QR exporter
# builds `${NEXT_PUBLIC_APP_URL}/t/{slug}`. No trailing slash. Falls back
# to https://app.tablebells.ae when unset (fine for a local preview of
# the print layout, WRONG for real printed tents).
NEXT_PUBLIC_APP_URL=

# --- Device cookie signing (server/auth/device-cookie.ts) -------------
# Generate with: openssl rand -base64 32
# DECISIONS.md ADR-4 anticipates rotating this quarterly -- the current
# sign/verify implementation checks against exactly one secret, so
# rotating it invalidates every outstanding guest device cookie at once.
# See device-cookie.ts's header for why that's a known limitation, not
# an oversight.
DEVICE_COOKIE_SECRET=

# --- Staff session cookie signing (server/auth/staff-session-cookie.ts) -
# Generate with: openssl rand -base64 32
# DELIBERATELY A SEPARATE SECRET from DEVICE_COOKIE_SECRET above -- a
# staff session cookie is a materially higher-value target than a bare
# guest device identity, and rotating one must never force-invalidate
# the other. Same single-secret limitation as DEVICE_COOKIE_SECRET
# applies here too (no grace-period rotation yet) -- rotating this
# invalidates every logged-in staff terminal's session at once.
STAFF_SESSION_SECRET=

# --- Firebase Admin SDK (lib/firebase/admin.ts) -----------------------
# NOT a service-account key -- ARCHITECTURE.md §8.6 forbids those. Local
# dev authenticates via `gcloud auth application-default login`, which
# needs no entry here. This project id is only used to disambiguate
# which project Application Default Credentials should target.
FIREBASE_PROJECT_ID=
