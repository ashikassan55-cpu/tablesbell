// =============================================================================
// TableBells -- Firestore Security Rules
// Implements ARCHITECTURE.md v3.0 Section 1.10, Section 8.1-8.9
//
// TRUST MODEL (Section 0):
//   Guest  - anonymous Firebase Auth, App Check attested, CREATE-ONLY on three
//            collections, never a price, never an update, never a delete.
//   Staff  - non-anonymous Firebase Auth + device-bound PIN, role-scoped,
//            branch-scoped, permitted a narrow set of field-level updates.
//   Server - Admin SDK (Cloud Functions, Next.js Server Actions). Bypasses
//            these rules entirely. This file is the enforcement surface for
//            every OTHER writer -- it is not decorative alongside the server
//            code, it is the actual gate a hostile client hits.
//   Platform - cross-tenant superadmin, non-anonymous + custom claim.
//
// SCHEMA NOTE for the pricing function (priceOrderRequest, Section 2.1):
//   Every orders/{orderId} document MUST be created with
//     adjustments: [], paymentStatus: 'UNPAID', receiptPrintedAt: null
//   already present. The cashier-update rules below diff against these
//   fields and require them to exist; a ticket created without them cannot
//   ever be settled through the console.
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // PRINCIPALS -- Section 1.4, Section 8.1 (guest/staff split)
    // -------------------------------------------------------------------

    // Firebase Auth writes this into the JWT at mint time from the actual
    // sign-in method used. It is NOT a custom claim: setCustomUserClaims()
    // cannot write into the reserved `firebase` namespace, so no forged
    // token can set this to anything other than what Firebase Auth chose.
    function provider() {
      return request.auth.token.firebase.sign_in_provider;
    }

    function isStaff(t) {
      return request.auth != null
          && provider() != 'anonymous'
          && request.auth.token.stf == true
          && request.auth.token.tid == t
          && request.auth.token.role in ['owner', 'manager', 'cashier', 'server', 'kitchen'];
    }

    function isGuest(t, b) {
      return request.auth != null
          && provider() == 'anonymous'
          && request.auth.token.gst == true
          && request.auth.token.tid == t
          && request.auth.token.bid == b;
    }

    function hasRole(rs)  { return request.auth.token.role in rs; }
    function inBranch(b)  { return b in request.auth.token.bids; }

    function isPlatform() {
      return request.auth != null
          && provider() != 'anonymous'
          && request.auth.token.plat == true;
    }

    // -------------------------------------------------------------------
    // PARTY OWNERSHIP -- the IDOR gate, Section 8.2
    // -------------------------------------------------------------------

    function party(t, b, s) {
      return get(/databases/$(database)/documents/tenants/$(t)/branches/$(b)/sessions/$(s)).data;
    }

    // Two independent checks, deliberately both required (Section 8.2):
    //   - the TOKEN was minted for exactly this session (ownsSessionClaim)
    //   - the CALLER is still a live member of that party right now (inParty)
    // Token binding alone leaves a window after a host removes a member;
    // membership alone would trust a claim-free token. Both, always.
    function inParty(p) {
      return request.auth.uid == p.hostUid || request.auth.uid in p.joinedUids;
    }
    function partyOpen(p)         { return p.status in ['active', 'idle', 'billing']; }
    function ownsSessionClaim(s)  { return request.auth.token.ses == s; }

    // -------------------------------------------------------------------
    // GHOST BAN GATE -- Section 8.7. Blocks by UID *and* by device id,
    // because a UID alone lives in clearable browser storage and is
    // defeated by a private tab; the device id rides an httpOnly cookie
    // the guest cannot touch. Either match is sufficient to block every
    // guest write path.
    // -------------------------------------------------------------------

    function banned(t) {
      let bannedUids = get(
        /databases/$(database)/documents/tenants/$(t)/security/bannedUsers
      ).data.uids;
      let bannedDids = get(
        /databases/$(database)/documents/tenants/$(t)/security/bannedDevices
      ).data.ids;
      return (request.auth.uid in bannedUids)
          || ('did' in request.auth.token && request.auth.token.did in bannedDids);
    }

    // -------------------------------------------------------------------
    // PAYLOAD HYGIENE -- Section 8.3 (price tampering), Section 8.4
    // (XSS / ESC-POS abuse)
    // -------------------------------------------------------------------

    // Rejects (not merely strips) any string containing HTML/template/
    // expression metacharacters -- < > { } $ ` \ -- or a carriage return
    // or line feed, and separately rejects known protocol-handler
    // substrings (javascript:, data:, vbscript:, onxxx=). matches() in
    // Firestore Rules is a FULL match against RE2, so the character
    // class must describe the entire string -- a partial-match habit
    // here is the common, silent way this control fails.
    //
    // WHAT THIS DOES NOT COVER, BY DESIGN: Firestore Rules' regex support
    // does not give a verifiable way to express arbitrary Unicode code-
    // point ranges (the bidirectional override/isolate characters that
    // can visually reverse text on a bilingual KDS screen) or raw
    // sub-0x20 control bytes such as the ESC byte that drives ESC-POS
    // thermal-printer control sequences. A hand-rolled attempt at that
    // here would be an unverifiable regex in a security-critical file --
    // a worse outcome than an honest boundary. That deeper normalization
    // is therefore done server-side, in sanitize.service.ts, on every
    // guest string BEFORE priceOrderRequest copies it from orderRequests
    // into the orders ticket the KDS screen and the printer actually
    // consume (Section 8.4, layers 1-2 and 5). Rules are the shape and
    // metacharacter gate; the function is the semantic and byte-level
    // gate -- neither alone is sufficient (Section 1.10).
    function safeText(s, maxLen) {
      return s is string
          && s.size() <= maxLen
          && s.matches('[^<>{}$`\\\\\\r\\n]*')
          && !s.matches('(?i).*(javascript:|data:|vbscript:|on[a-z]+\\s*=).*');
    }

    // A guest payload containing ANY of these keys is rejected outright --
    // not ignored, not stripped. Section 8.3: the client is structurally
    // incapable of expressing a price. Only priceOrderRequest (Admin SDK)
    // ever writes a money field, and it bypasses these rules entirely.
    function noMoneyFields() {
      return !request.resource.data.keys().hasAny([
        'priceFils', 'unitPriceFils', 'grossFils', 'netFils', 'vatFils',
        'lineTotalFils', 'totalFils', 'discountFils', 'creditFils', 'amountFils'
      ]);
    }

    function authoredNow(uidField) {
      return request.resource.data[uidField] == request.auth.uid
          && request.resource.data.createdAt == request.time;
    }

    // -------------------------------------------------------------------
    // CASHIER BILL UPDATE -- the ONE staff write path directly onto
    // `orders` and `sessions`. Everything else about those documents
    // (line items, gross/net/vat, ticket lifecycle status) remains
    // Admin-SDK-only, because rules cannot safely perform fils-integer
    // VAT arithmetic and must not become a second place that math is
    // allowed to happen (Section 1.9's "one function, no exceptions"
    // invariant would otherwise be silently violated the first time a
    // cashier's tablet writes a total directly).
    //
    // What this DOES allow a cashier/manager/owner to set, directly:
    //   - paymentStatus:      'UNPAID' | 'PAID_CASH' | 'PAID_CARD'
    //   - receiptPrintedAt:   null, or the server's own request.time
    //   - adjustments[]:      an audit ledger of discount/void/comp
    //                         entries, APPEND-ONLY -- the prior array
    //                         must reappear unchanged as a prefix
    //   - updatedAt / updatedBy: audit stamps, forced to request.time / uid
    //
    // What it can NEVER touch, enforced by diff().affectedKeys().hasOnly():
    //   items, grossFils, netFils, vatFils, status, code, sessionId,
    //   tableId, requestId, placedAt, placedBy, billId, and everything else.
    // -------------------------------------------------------------------

    function billMetaKeysOnly(before, after) {
      return after.diff(before).affectedKeys().hasOnly([
        'adjustments', 'paymentStatus', 'receiptPrintedAt', 'updatedAt', 'updatedBy'
      ]);
    }

    function validPaymentStatus(s) {
      return s in ['UNPAID', 'PAID_CASH', 'PAID_CARD'];
    }

    // Forward settlement is open to any billing-capable staff member;
    // reversing an already-paid status back to UNPAID (a correction, or
    // a walked-back mistaken settlement) requires manager/owner -- the
    // same override-authority line the architecture draws for discounts
    // (Section 8.3).
    function validPaymentTransition(before, after) {
      return (before.paymentStatus == 'UNPAID' && validPaymentStatus(after.paymentStatus))
          || (before.paymentStatus != 'UNPAID' && after.paymentStatus == before.paymentStatus)
          || (before.paymentStatus != 'UNPAID' && after.paymentStatus == 'UNPAID'
                && hasRole(['owner', 'manager']));
    }

    // receiptPrintedAt only ever moves forward, and only to the server's
    // own clock -- never to an arbitrary client-supplied timestamp, and
    // never back to null (a receipt cannot become "unprinted").
    function validReceiptStamp(before, after) {
      return after.receiptPrintedAt == before.receiptPrintedAt
          || after.receiptPrintedAt == request.time;
    }

    // Exactly one new entry, and the entire prior array must reappear
    // untouched as its prefix -- this is what makes "append-only" a
    // provable property here rather than a naming convention:
    //   after.adjustments == before.adjustments.concat([theOneNewEntry])
    // A financial entry (amountFils > 0) additionally requires
    // manager/owner override authority; a cashier alone may only log a
    // zero-value bookkeeping entry (e.g. a printed-receipt note).
    function validAdjustmentAppend(before, after) {
      return after.adjustments.size() == before.adjustments.size() + 1
          && after.adjustments == before.adjustments.concat(
               [ after.adjustments[after.adjustments.size() - 1] ]
             )
          && validAdjustmentEntry(after.adjustments[after.adjustments.size() - 1], before);
    }

    function validAdjustmentEntry(entry, order) {
      return entry.keys().hasOnly(['type', 'amountFils', 'reason', 'byUid', 'byRole', 'at'])
          && entry.type in ['discount', 'void_credit', 'comp', 'note']
          && entry.amountFils is int
          && entry.amountFils >= 0
          && entry.amountFils <= order.grossFils
          && (entry.amountFils == 0 || hasRole(['owner', 'manager']))   // Section 8.3 override line
          && safeText(entry.reason, 150)
          && entry.byUid == request.auth.uid
          && entry.byRole == request.auth.token.role
          && entry.at == request.time;
    }

    function isCashierBillUpdate(t, b, before, after) {
      return isStaff(t) && inBranch(b) && hasRole(['owner', 'manager', 'cashier'])
          && billMetaKeysOnly(before, after)
          && after.updatedAt == request.time
          && after.updatedBy == request.auth.uid
          && (
               !('paymentStatus' in after.diff(before).affectedKeys())
               || validPaymentTransition(before, after)
             )
          && (
               !('receiptPrintedAt' in after.diff(before).affectedKeys())
               || validReceiptStamp(before, after)
             )
          && (
               !('adjustments' in after.diff(before).affectedKeys())
               || validAdjustmentAppend(before, after)
             );
    }

    // -------------------------------------------------------------------
    // ROOT COLLECTIONS -- never client-readable or writable, Section 8.1
    // -------------------------------------------------------------------

    match /tableSlugs/{slug} { allow read, write: if false; }   // resolved by Admin SDK only
    match /inviteCodes/{code} { allow read, write: if false; }
    match /auditLogs/{logId} {
      allow read: if isPlatform();
      allow write: if false;
    }

    // -------------------------------------------------------------------
    // TENANT -- hierarchical multi-tenancy root, Section 1.1-1.3
    // -------------------------------------------------------------------

    match /tenants/{t} {
      allow read:  if isStaff(t) || isPlatform();
      allow write: if false;                                    // Admin SDK only

      match /menuItems/{itemId} {
        allow read:  if isStaff(t);
        allow write: if false;
      }

      match /members/{uid} {
        allow read:  if isStaff(t) && (hasRole(['owner', 'manager']) || uid == request.auth.uid);
        allow write: if false;
      }

      match /security/{doc}        { allow read, write: if false; }  // bannedUsers, bannedDevices
      match /bannedIdentities/{id} {
        allow read:  if isStaff(t) && hasRole(['owner', 'manager']);
        allow write: if false;
      }
      match /guestDevices/{d} { allow read, write: if false; }

      // --- BRANCH -- the real-time operational hot path -----------------
      match /branches/{b} {
        allow read: if (isStaff(t) && inBranch(b)) || isPlatform();

        // -- guest-readable, single broadcast documents ------------------
        match /menuPublished/{v} {
          allow read:  if isStaff(t) || isGuest(t, b);
          allow write: if false;                                  // publishMenu (Admin SDK) only
        }
        match /live/{doc} {
          allow read:  if isStaff(t) || isGuest(t, b);
          allow write: if false;
        }

        // -- Manager Menu Maker draft (ADR-8) ---------------------------
        // Never guest-readable, and only owner/manager among staff. The
        // draft can carry a not-yet-published price; a `server`/`cashier`/
        // `kitchen` client has no business reading it. Writes are
        // saveMenuDraft / publishMenu (Admin SDK), never a client.
        match /menuDraft/{d} {
          allow read:  if isStaff(t) && inBranch(b) && hasRole(['owner', 'manager']);
          allow write: if false;
        }

        // -- sessions (parties) -- Section 3.1, 8.2, 8.6 ------------------
        match /sessions/{s} {
          allow read: if (isStaff(t) && inBranch(b))
                      || (isGuest(t, b) && ownsSessionClaim(s) && inParty(resource.data));

          // The ONLY client-writable path onto a session: the cashier
          // bill-meta fields. Party lifecycle (open/idle/close/transfer),
          // runningTotals, hostUid, joinedUids -- all Admin-SDK-only.
          allow update: if isCashierBillUpdate(t, b, resource.data, request.resource.data);
          allow create, delete: if false;

          match /alerts/{a} {
            allow read: if (isStaff(t) && inBranch(b))
                        || (isGuest(t, b) && ownsSessionClaim(s));
            allow write: if false;                                // server/staff-action only
          }
        }

        // -- orders (priced KDS tickets) -- Section 1.8, 2, 8.3 -----------
        match /orders/{o} {
          allow read: if (isStaff(t) && inBranch(b))
                      || (isGuest(t, b) && ownsSessionClaim(resource.data.sessionId));

          // Same narrow cashier-meta path as sessions above. Ticket
          // lifecycle (new -> prep -> ready -> served/voided), items[],
          // and every money field remain reachable ONLY through
          // priceOrderRequest and the KDS server actions (advanceTicket,
          // voidTicketLine, voidTicket, flagGhostOrder) -- all Admin SDK,
          // all bypassing this file, all audited in orders/{o}/events.
          allow update: if isCashierBillUpdate(t, b, resource.data, request.resource.data);
          allow create, delete: if false;

          match /events/{e} {
            allow read:  if isStaff(t) && inBranch(b);
            allow write: if false;                                // append-only audit trail
          }
        }

        // -- bills -- the authoritative financial record, Section 6.4 ----
        // orders.paymentStatus / receiptPrintedAt above are denormalized
        // read-model fields for the console UI; bills/{billId}.status
        // (open/pending_payment/authorized/paid/void/refunded) remains
        // the system of record and is written exclusively by
        // bill.actions.ts through the Admin SDK.
        match /bills/{bl} {
          allow read: if (isStaff(t) && inBranch(b) && hasRole(['owner', 'manager', 'cashier']))
                      || (isGuest(t, b) && ownsSessionClaim(resource.data.sessionId));
          allow write: if false;

          match /payments/{p} {
            allow read: if (isStaff(t) && inBranch(b) && hasRole(['owner', 'manager', 'cashier']))
                        || (isGuest(t, b) && ownsSessionClaim(get(
                             /databases/$(database)/documents/tenants/$(t)/branches/$(b)/bills/$(bl)
                           ).data.sessionId));
            allow write: if false;
          }
        }

        // =================================================================
        // THE GUEST WRITE SURFACE -- create-only, three collections total.
        // This block IS the enforcement of invariants 2 and 3 (Section 0.2).
        // =================================================================

        match /orderRequests/{r} {
          allow read: if (isStaff(t) && inBranch(b))
                      || (isGuest(t, b) && resource.data.createdBy == request.auth.uid);

          allow create: if isGuest(t, b)
                        && !banned(t)
                        && ownsSessionClaim(request.resource.data.sessionId)
                        && inParty(party(t, b, request.resource.data.sessionId))
                        && partyOpen(party(t, b, request.resource.data.sessionId))
                        && authoredNow('createdBy')
                        && request.resource.data.status == 'pending'
                        && request.resource.data.keys().hasOnly([
                             'sessionId', 'tableId', 'lines', 'note',
                             'clientRequestId', 'createdBy', 'createdAt', 'status',
                             'guestName'                       // ADR-11 — optional, checkout-only
                           ])
                        && noMoneyFields()
                        && request.resource.data.lines is list
                        && request.resource.data.lines.size() >= 1
                        && request.resource.data.lines.size() <= 40
                        && safeText(request.resource.data.note, 150)
                        // ADR-11: guestName is optional; when present it must be a
                        // short, safe string. Server-side `sanitizeGuestText`
                        // re-cleans it before it lands on the priced order.
                        && (!('guestName' in request.resource.data)
                            || safeText(request.resource.data.guestName, 60))
                        && request.resource.data.clientRequestId is string
                        && request.resource.data.clientRequestId.size() <= 64;

          allow update, delete: if false;    // guests cannot cancel -- they ask a human, Section 1.7
        }

        match /serviceCalls/{c} {
          allow read: if (isStaff(t) && inBranch(b))
                      || (isGuest(t, b) && ownsSessionClaim(resource.data.sessionId));

          allow create: if isGuest(t, b)
                        && !banned(t)
                        && ownsSessionClaim(request.resource.data.sessionId)
                        && inParty(party(t, b, request.resource.data.sessionId))
                        && partyOpen(party(t, b, request.resource.data.sessionId))
                        && authoredNow('createdBy')
                        && request.resource.data.status == 'open'
                        && request.resource.data.type in
                             ['waiter', 'water', 'bill', 'cleanup', 'napkins', 'assistance']
                        && request.resource.data.keys().hasOnly([
                             'sessionId', 'tableId', 'type', 'note', 'createdBy', 'createdAt', 'status'
                           ])
                        && safeText(request.resource.data.note, 150);

          allow update, delete: if false;    // staff ack/resolve via Admin SDK only
        }

        match /partyJoinRequests/{r} {
          allow create: if isGuest(t, b)
                        && !banned(t)
                        && authoredNow('createdBy')
                        && request.resource.data.status == 'pending'
                        && request.resource.data.keys().hasOnly([
                             'inviteCodeHash', 'sessionId', 'createdBy', 'createdAt', 'status'
                           ]);
          allow read:   if isGuest(t, b) && resource.data.createdBy == request.auth.uid;
          allow update, delete: if false;
        }

        // -- staff-only operational reads ---------------------------------
        match /tables/{tb} {
          allow read:  if isStaff(t) && inBranch(b);
          allow write: if false;                                  // transfer.service, Admin SDK
        }
        match /staffAlerts/{a} {
          allow read:  if isStaff(t) && inBranch(b);
          allow write: if false;
        }
        match /devices/{d} {
          allow read:  if isStaff(t) && hasRole(['owner', 'manager']);
          allow write: if false;
        }
        match /analyticsDaily/{d} {
          allow read:  if isStaff(t) && hasRole(['owner', 'manager']);
          allow write: if false;
        }
        match /partyInvites/{i} { allow read, write: if false; }  // server-only, Section 5.3
        match /counters/{c}     { allow read, write: if false; }
        match /scanEvents/{e}   { allow read, write: if false; }

        // Deny-by-default for anything not explicitly matched above.
        match /{document=**} { allow write: if false; }
      }
    }

    // -------------------------------------------------------------------
    // GLOBAL DEFAULT DENY -- Section 1.10, 8.6. Every path not explicitly
    // opened above falls here. Cross-tenant reads have no path to reach:
    // a rule that granted them would have to appear above this line, and
    // none do.
    // -------------------------------------------------------------------

    match /{document=**} { allow read, write: if false; }
  }
}
